int procurar(int chave) {
    int v[5];
    int i;

    v[0] = 10;
    v[1] = 20;
    v[2] = 30;
    v[3] = 40;
    v[4] = 50;
    
    for (i = 0; i < 5; i = i + 1) {
        if (v[i] == chave) {
            return i;
        }
    }
    
    // Nao encontrou
    return -1;
}

int main() {
    int indice;
    
    print("Procurando pelo numero 40...");
    indice = procurar(40);
    print(indice); //deve imprimir 3
    
    print("Procurando pelo numero 99...");
    indice = procurar(99);
    print(indice); //deve imprimir -1
    
    return 0;
}