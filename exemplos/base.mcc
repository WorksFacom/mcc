/* TESTE DEFINITIVO DO MICRO C 
   Valida: Strings, Logic, Math, Recursion, Bytes
*/

int fatorial(int n) {
    if (n <= 1) return 1;
    return n * fatorial(n - 1);
}

int main() {
    print("=== INICIO DO TESTE ===");

    /* 1. Teste de Strings e Atribuicao Automatica (IR_STRCPY) */
    char nome[50];
    nome = "Micro C Compiler";
    print("Compilador:");
    print(nome);

    /* 2. Teste de Manipulacao de Bytes (IR_STORE_BYTE / IR_LOAD_BYTE) */
    /* Se isso falhar, vai imprimir apenas a primeira letra ou lixo */
    char buffer[10];
    buffer[0] = 'O';
    buffer[1] = 'K';
    buffer[2] = '\0';
    print("Teste de Bytes Manual:");
    print(buffer);

    /* 3. Teste de Aritmetica e Precedencia */
    int a; 
    int b;
    a = 10; 
    b = 5;
    int res;
    res = a * b + 10 / 2; /* deve ser 50 + 5 = 55 */
    
    print("Teste Aritmetico (10 * 5 + 10 / 2):");
    print(res); 

    /* 4. Teste de Logica Booleana (Correcao do Parser) */
    print("Teste Logico:");
    if ((a == 10 && b == 5) || (a == 999)) {
        print("Sucesso: Logica AND/OR funciona!");
    } else {
        print("Falha: Erro na logica booleana.");
    }

    /* 5. Teste de Loops e Recursao */
    print("Teste de Loop e Recursao (Fatoriais):");
    int i;
    for (i = 1; i <= 5; i = i + 1) {
        int f;
        f = fatorial(i);
        print(f);
    }

    /* 6. Sobrescrita de String (Validacao final de memoria) */
    nome = "Teste Finalizado com Sucesso!";
    print(nome);

    return 0;
}