int fibonacci(int n) {
    int resultado;
    
    if (n <= 1) {
        resultado = n;
        return resultado;
    }
     
    
    return fibonacci(n - 1) + fibonacci(n - 2);
    
    
    }

int main() {
    print("Calculando fibonacci(8)...");
    print(fibonacci(8)); // Deve imprimir 21
    return 0;
}