int soma(int a, int b) {
    int resultado = a + b;
    return resultado;
}

int main() {
    int x = 12;
    int y;
    int z;

    if (x < 20) {
        y = 1;
    } else {
        y = 2;
    }

    z = soma(x, y);

    char abc = 'P';

    print(abc); 

    return 0;
}