// arquivo: teste.cmm
int soma(int a, int b) {
    int v[10];
    int i;
    int res;

    print("--- Entrou na funcao 'soma' ---");
    
    // 1. Primeiro 'for': Preenche o array usando os parametros
    //    Isso testa 'IR_STORE' dentro de um laço
    for (i = 0; i < 10; i = i + 1) {
        v[i] = a + b + i; // ex: v[0]=13, v[1]=14, ...
    }

    print("--- Imprimindo valores do array 'v' (de dentro da soma):");

    // 2. Segundo 'for': Imprime os valores do array
    //    Isso testa 'IR_LOAD' e 'IR_PRINT_INT' dentro de um laço
    for (i = 0; i < 10; i = i + 1) {
        print(v[i]);
    }

    res = a + b;
    print("--- Saindo da funcao 'soma' ---");
    return res;
}

int main() {
    int x = 12;
    int y;
    int z;

    print("--- Iniciando 'main' ---");

    if (x < 20) {
        y = 1;
    } else {
        y = 2;
    }
    
    print("Valor de y apos o 'if':");
    print(y); // Deve imprimir 1

    print("Chamando soma(12, 1)...");
    z = soma(x, y);

    print("Valor de retorno (z) em 'main':");
    print(z); // Deve imprimir 13

    return 0;
}